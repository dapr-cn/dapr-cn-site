---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在" path="/404/">
  <section class="container section not-found">
    <h1>页面不存在</h1>
    <p>你访问的地址没有对应的页面。可以回到首页，或从顶部导航找到需要的内容。</p>
    <p><a class="button" href="/">回到首页</a></p>
  </section>
</BaseLayout>
