---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import { routeParam } from '../../lib/sections';

// Pages of the source-study section, served at /source/. `index` (the landing) has no route parameter.
export async function getStaticPaths() {
  const entries = await getCollection('source', (entry) => !entry.data.draft);
  const items = entries.map((entry) => ({ id: entry.id, title: entry.data.title, weight: entry.data.weight }));
  return entries.map((entry) => ({ params: { id: routeParam(entry.id) }, props: { entry, items } }));
}

interface Props {
  entry: CollectionEntry<'source'>;
  items: { id: string; title: string; weight?: number }[];
}

const { entry, items } = Astro.props;
const { Content } = await render(entry);
---

<SectionLayout
  collection="source"
  id={entry.id}
  title={entry.data.title}
  summary={entry.data.summary}
  lead={entry.data.lead}
  groups={entry.data.groups}
  items={items}
>
  <Content />
</SectionLayout>
