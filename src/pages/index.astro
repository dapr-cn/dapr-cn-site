---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import Hero from '../components/home/Hero.astro';
import OfficialOverview from '../components/home/OfficialOverview.astro';
import Closing from '../components/home/Closing.astro';
import Activities from '../components/home/Activities.astro';
import EventList from '../components/home/EventList.astro';
import PostGrid from '../components/home/PostGrid.astro';
import PostList from '../components/home/PostList.astro';
import TagCloud from '../components/home/TagCloud.astro';
import { site } from '../config/site';
import { splitEvents } from '../lib/events';
import { tagTerms } from '../lib/tags';
import { tagDescriptions } from '../lib/tag-links';
import { urls } from '../lib/urls';

// The community's own content comes first; the translated Dapr overview follows it.
const [posts, events, publications] = await Promise.all([
  getCollection('post', (entry) => !entry.data.draft),
  getCollection('event'),
  getCollection('publication'),
]);
const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.getTime() - a.data.date.getTime();

const { upcoming, past } = splitEvents(events, new Date());
// The hero shows the newest three. Nothing below repeats them: the featured cards skip them
// (featured posts first, then the next newest with a cover) and the list continues after both.
const sorted = [...posts].sort(byDate);
const newest = sorted.slice(0, 3);
const shown = new Set(newest.map((post) => post.id));
const featured = [
  ...sorted.filter((post) => post.data.featured && !shown.has(post.id)),
  ...sorted.filter((post) => !post.data.featured && !shown.has(post.id) && post.data.header?.image),
].slice(0, 3);
featured.forEach((post) => shown.add(post.id));
const earlier = sorted.filter((post) => !shown.has(post.id)).slice(0, 6);
// Tags with no entries (description only) stay out of the cloud.
const terms = tagTerms(
  [...posts, ...events, ...publications].map((entry) => ({ tags: entry.data.tags })),
  await tagDescriptions(),
)
  .filter((term) => term.count > 0)
  .slice(0, 40);

const titleOf = async (id: string, fallback: string) => (await getEntry('pages', id))?.data.title ?? fallback;
const upcomingTitle = await titleOf('home/events-incoming', '即将开始的活动');
const reviewTitle = await titleOf('home/events-review', '精彩活动回顾');
const featuredTitle = await titleOf('home/featured-posts', '热门文章');
const recentTitle = await titleOf('home/posts', '最新文章');
const tagsTitle = await titleOf('home/tags', '标签云');
---

<BaseLayout title={undefined} description={site.description} path={urls.home()}>
  <Hero latestTitle={recentTitle} latest={newest} />
  <div class="home">
    <Activities />
    <EventList id="upcoming-title" title={upcomingTitle} events={upcoming} />
    <PostGrid title={featuredTitle} posts={featured} />
    <PostList title="往期文章" posts={earlier} />
    <EventList id="review-title" title={reviewTitle} events={past.slice(0, 3)} />
    <TagCloud title={tagsTitle} terms={terms} />
  </div>
  <OfficialOverview />
  <Closing />
</BaseLayout>
