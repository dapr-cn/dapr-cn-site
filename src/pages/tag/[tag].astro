---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import EventCard from '../../components/EventCard.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { tagSlug, tagTerms } from '../../lib/tags';
import { urls } from '../../lib/urls';

// One archive per tag: every tag on an entry, and every tag that has a description in src/content/tag.
// Tags with no slug (empty values) produce no page.
export async function getStaticPaths() {
  const [posts, events, publications, descriptions] = await Promise.all([
    getCollection('post', (entry) => !entry.data.draft),
    getCollection('event'),
    getCollection('publication'),
    getCollection('tag'),
  ]);
  const all = [...posts, ...events, ...publications];
  const terms = tagTerms(
    all.map((entry) => ({ tags: entry.data.tags })),
    descriptions.map((entry) => ({ id: entry.id, title: entry.data.title })),
  );
  return terms.map((term) => ({
    params: { tag: term.url },
    props: {
      term,
      description: descriptions.find((entry) => tagSlug(entry.data.title) === term.slug),
      posts: posts.filter((post) => post.data.tags.some((tag) => tagSlug(tag) === term.slug)),
      events: events.filter((event) => event.data.tags.some((tag) => tagSlug(tag) === term.slug)),
      publications: publications.filter((pub) => pub.data.tags.some((tag) => tagSlug(tag) === term.slug)),
    },
  }));
}

const { term, description, posts, events, publications } = Astro.props;
const rendered = description ? await render(description) : undefined;
const hasEntries = posts.length + events.length + publications.length > 0;
---

<BaseLayout
  title={`标签：${term.name}`}
  description={description?.data.summary ?? `标签「${term.name}」下的文章、活动和出版物`}
  path={urls.tag(term.url)}
>
  <section class="container section">
    <h1>标签：{term.name}</h1>
    {rendered && (
      <div class="prose tag-description">
        <rendered.Content />
      </div>
    )}
    {term.count > 0 && <p class="muted">共 {term.count} 条</p>}
    {
      posts.length > 0 && (
        <>
          <h2 class="section-title">文章</h2>
          <ul class="card-grid three">
            {posts.map((post) => <PostCard post={post} />)}
          </ul>
        </>
      )
    }
    {
      events.length > 0 && (
        <>
          <h2 class="section-title">活动</h2>
          <ul class="card-grid three">
            {events.map((event) => <EventCard event={event} />)}
          </ul>
        </>
      )
    }
    {
      publications.length > 0 && (
        <>
          <h2 class="section-title">出版</h2>
          <ul class="card-grid three">
            {publications.map((publication) => <PublicationCard publication={publication} />)}
          </ul>
        </>
      )
    }
    {!hasEntries && !rendered && <p class="muted">这个标签下还没有内容。</p>}
  </section>
</BaseLayout>
