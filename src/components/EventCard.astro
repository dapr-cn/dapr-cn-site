---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CardCue from './CardCue.astro';
import { formatDate } from '../lib/format';
import { urls } from '../lib/urls';

interface Props {
  event: CollectionEntry<'event'>;
}

const { event } = Astro.props;
const cover = event.data.image?.filename;
---

<li class="card event-card" data-card>
  {cover && <Image src={cover} alt="" width={640} class="cover" />}
  <h3><a href={urls.event(event.id)}>{event.data.title}</a></h3>
  <ul class="meta">
    <li><time datetime={event.data.date.toISOString()}>{formatDate(event.data.date, true)}</time></li>
    {event.data.location && <li>{event.data.location}</li>}
  </ul>
  {event.data.summary && <p class="summary">{event.data.summary}</p>}
  <div class="card-foot">
    <CardCue label="查看活动" />
  </div>
</li>
