---
import { nav, currentNavItem } from '../config/nav';
import { site } from '../config/site';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

interface Props {
  /** Path of the current page. Defaults to the request path, which is what Starlight's frame passes. */
  path?: string;
}

const path = Astro.props.path ?? Astro.url.pathname;
const current = currentNavItem(path);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/media/dapr_logo.svg" alt="" width="32" height="32" />
      <span>{site.title}</span>
    </a>
    <nav class="nav-desktop" aria-label="主导航" data-nav-desktop>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current?.href === item.href ? 'page' : undefined}>
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
    <div class="header-tools">
      <Search />
      <ThemeSelect />
      <details class="nav-mobile" data-nav-mobile>
        <summary>
          <svg class="menu-icon" aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
            <path class="bar-a" d="M2 5h12" />
            <path class="bar-b" d="M2 11h12" />
          </svg>
          <span>菜单</span>
        </summary>
        <nav aria-label="移动端导航">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current?.href === item.href ? 'page' : undefined}>
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    --wash: color-mix(in srgb, var(--color-header-text) 12%, transparent);
    --wash-strong: color-mix(in srgb, var(--color-header-text) 20%, transparent);
    --line: color-mix(in srgb, var(--color-header-text) 50%, transparent);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--color-header-bg);
    color: var(--color-header-text);
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header .header-inner {
    max-width: var(--chrome-width);
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-header-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand img {
    background: #fff;
    border-radius: 6px;
    padding: 2px;
    width: var(--brand-mark);
    height: var(--brand-mark);
  }

  .nav-desktop {
    display: none;
    flex: 1;
    min-width: 0;
    position: relative;
  }

  .nav-desktop ul,
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .nav-desktop a,
  .nav-mobile a {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--color-header-text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-desktop a {
    position: relative;
    z-index: 1;
  }

  .nav-desktop a:hover,
  .nav-mobile a:hover,
  .brand:hover {
    color: var(--color-header-text);
  }

  .nav-desktop a:hover,
  .nav-mobile a:hover {
    background: var(--wash);
  }

  .nav-desktop a[aria-current='page'],
  .nav-mobile a[aria-current='page'] {
    background: var(--wash-strong);
    font-weight: 700;
  }

  /* With scripting, one indicator carries both the hover and the current-page wash. It glides to the
     link under the pointer or focus and returns to the current page; without scripting the links
     keep their own backgrounds above. */
  .nav-desktop.has-indicator a,
  .nav-desktop.has-indicator a[aria-current='page'] {
    background: transparent;
  }

  .nav-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--ind-w, 0px);
    height: var(--ind-h, 0px);
    transform: translate(var(--ind-x, 0px), var(--ind-y, 0px));
    border-radius: 6px;
    background: var(--wash-strong);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.4s var(--ease-out),
      width 0.4s var(--ease-out),
      opacity 0.2s ease-out;
  }

  .nav-desktop.is-active .nav-indicator {
    opacity: 1;
  }

  .nav-desktop.no-glide .nav-indicator {
    transition: opacity 0.2s ease-out;
  }

  .header-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  /* Starlight's search button and theme select, drawn as masthead pills. */
  .header-tools :global(button[data-open-modal]) {
    height: 36px;
    min-width: 36px;
    justify-content: center;
    gap: 8px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-header-text);
    font-size: 0.9rem;
    width: auto;
    max-width: none;
  }

  .header-tools :global(button[data-open-modal]:hover) {
    background: var(--wash);
    border-color: var(--color-header-text);
    color: var(--color-header-text);
  }

  .header-tools :global(button[data-open-modal] > :last-child) {
    margin-inline-start: 0;
  }

  .header-tools :global(button[data-open-modal] kbd) {
    background: var(--wash);
    color: inherit;
    border-radius: 999px;
    padding-inline: 8px;
  }

  .header-tools :global(starlight-theme-select label) {
    height: 36px;
    color: var(--color-header-text);
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
    padding-inline: 0.5rem;
  }

  .header-tools :global(starlight-theme-select label:hover) {
    background: var(--wash);
    border-color: var(--color-header-text);
    color: var(--color-header-text);
  }

  .header-tools :global(starlight-theme-select select) {
    padding-block: 0;
    height: 34px;
    font-size: 0.9rem;
  }

  .header-tools :global(starlight-theme-select option) {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--color-header-text);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile summary:hover,
  .nav-mobile[open] summary {
    background: var(--wash);
  }

  .menu-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-mobile[open] .bar-a {
    transform: translateY(3px) rotate(45deg);
  }

  .nav-mobile[open] .bar-b {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* The panel hangs from the masthead's lower edge across the full width. */
  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    background: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 8px var(--gutter) 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  @starting-style {
    .nav-mobile[open] nav {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .nav-mobile ul {
    flex-direction: column;
    gap: 0;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .nav-mobile a {
    display: block;
    padding: 12px 10px;
    font-size: 1rem;
  }

  @media (max-width: 639px) {
    .header-tools :global(starlight-theme-select label) {
      width: 36px;
      padding-inline: 0;
      justify-content: center;
    }

    .header-tools :global(starlight-theme-select select) {
      width: 36px;
      margin-inline: 0;
      padding-inline: 0;
      color: transparent;
    }

    .header-tools :global(starlight-theme-select .label-icon) {
      inset-inline-start: 50%;
      margin-inline-start: -0.4375rem;
    }

    .header-tools :global(starlight-theme-select .caret) {
      display: none;
    }
  }

  @media (max-width: 799px) {
    .header-tools :global(button[data-open-modal]) {
      width: 36px;
      padding: 0;
    }
  }

  @media (max-width: 389px) {
    .brand {
      font-size: 0.95rem;
      gap: 8px;
    }

    .header-inner {
      gap: 8px;
    }

    .header-tools {
      gap: 4px;
    }
  }

  @media (min-width: 960px) {
    .nav-desktop {
      display: block;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>

<style is:global>
  /* Registered so the browser can interpolate them while scrolling. */
  @property --header-h {
    syntax: '<length>';
    inherits: true;
    initial-value: 60px;
  }

  @property --brand-mark {
    syntax: '<length>';
    inherits: true;
    initial-value: 32px;
  }

  @keyframes dapr-header-condense {
    to {
      --header-h: 48px;
      --brand-mark: 26px;
    }
  }

  @keyframes dapr-read-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Reading progress: a 2px line on the masthead's lower edge, article pages only. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--color-header-text);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  /* The masthead condenses from 60px to 48px over the first 96px of scroll, and the progress line
     fills with the page. Browsers without scroll-driven animations keep the 60px bar and no line. */
  @supports (animation-timeline: scroll()) {
    /* On the root so the sticky rails and Starlight's mobile contents bar can follow the same value. */
    :root {
      animation: dapr-header-condense linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 96px;
    }

    :root:has(.article) .site-header::after {
      animation: dapr-read-progress linear both;
      animation-timeline: scroll(root block);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav-desktop]');

  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const current = links.find((link) => link.getAttribute('aria-current') === 'page');

    const place = (link: HTMLElement | undefined, glide: boolean) => {
      if (!link || link.offsetWidth === 0) {
        nav.classList.remove('is-active');
        return;
      }
      const wasActive = nav.classList.contains('is-active');
      // The first placement, a resize and a font swap jump to position; only moves glide.
      const jump = !glide || !wasActive;
      if (jump) nav.classList.add('no-glide');
      nav.style.setProperty('--ind-x', `${link.offsetLeft}px`);
      nav.style.setProperty('--ind-y', `${link.offsetTop}px`);
      nav.style.setProperty('--ind-w', `${link.offsetWidth}px`);
      nav.style.setProperty('--ind-h', `${link.offsetHeight}px`);
      nav.classList.add('is-active');
      if (jump) {
        void nav.offsetWidth;
        nav.classList.remove('no-glide');
      }
    };

    const rest = () => place(current, true);

    nav.classList.add('has-indicator');
    place(current, false);

    for (const link of links) {
      link.addEventListener('pointerenter', () => place(link, true));
      link.addEventListener('focus', () => place(link, true));
    }
    nav.addEventListener('pointerleave', rest);
    nav.addEventListener('focusout', (event) => {
      if (!nav.contains(event.relatedTarget as Node | null)) rest();
    });

    const settle = () => place(current, false);
    new ResizeObserver(settle).observe(nav);
    document.fonts?.ready.then(settle);
  }

  const menu = document.querySelector<HTMLDetailsElement>('[data-nav-mobile]');

  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
