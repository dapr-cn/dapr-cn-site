---
// Heading row of a home section: the title, and an optional link to the full list on the right.
interface Props {
  id: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { id, title, href, linkLabel } = Astro.props;
---

<div class="section-head">
  <h2 id={id}>{title}</h2>
  {href && linkLabel && <a href={href}>{linkLabel}</a>}
</div>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-bottom: 1.4rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    line-height: 1.3;
  }

  .section-head a {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .section-head a:hover {
    text-decoration: underline;
  }
</style>
