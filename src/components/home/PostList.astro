---
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import { formatDate } from '../../lib/format';
import { urls } from '../../lib/urls';

// Earlier posts as a compact list: the ones the hero's newest list does not already show. Renders
// nothing when there are none.
interface Props {
  title: string;
  posts: CollectionEntry<'post'>[];
}

const { title, posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="home-section container" aria-labelledby="recent-title">
      <SectionHead id="recent-title" title={title} href={urls.postList()} linkLabel="浏览博客" />
      <ul class="recent-list">
        {posts.map((post) => (
          <li>
            <a href={urls.post(post.id)}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .recent-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 160ms ease-out;
  }

  .recent-list li:hover {
    background: var(--color-surface);
  }

  .recent-list a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    flex: 1 1 24rem;
    text-wrap: pretty;
  }

  .recent-list a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  .recent-list time {
    color: var(--color-muted);
    font-size: 0.9rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
</style>
