---
import { officialHome as content } from '../../data/official-home';
import SectionHead from './SectionHead.astro';

// The translated Dapr overview. One attribution note at the top covers every claim, case study,
// logo and third-party offer below it; the sections themselves stay free of repeated disclaimers.
const caseStudies = content.caseStudies.slice(0, 3);
---

<div class="official-overview">
  <section class="container home-section" aria-labelledby="official-title">
    <SectionHead id="official-title" title="了解 Dapr" href="/learn/" linkLabel="学习 Dapr" />
    <p class="source-note">
      本部分改编自 <a href="https://github.com/dapr/website/tree/460d369">Dapr 官网（dapr/website，460d369）</a>，由中国社区翻译整理。案例、采用者名单、第三方服务和效率表述均来自官网，并非中国社区的客户、独立测量或背书。商标属于各自权利人，价格与可用性以提供方为准。
    </p>
    <p class="section-intro">{content.values.intro}</p>
    <div class="value-rows">
      {content.values.items.map((item) => (
        <div class="value-item">
          <figure>
            <img src={item.diagram} alt={item.diagramDesc} width="1200" height="624" loading="lazy" />
          </figure>
          <h3>{item.name}</h3>
          {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="apis-title">
    <SectionHead id="apis-title" title={content.apis.title} href="https://docs.dapr.io/developing-applications/building-blocks/" linkLabel="构建块文档" />
    <p class="section-intro">{content.apis.intro}</p>
    <figure class="api-diagram">
      <img src={content.apis.diagram} alt={content.apis.diagramDesc} width="1200" height="624" loading="lazy" />
    </figure>
    <details class="api-more">
      <summary>查看全部 {content.apis.items.length} 个构建块 API 的说明</summary>
      <ul class="api-list">
        {content.apis.items.map((item) => (
          <li>
            <img src={item.icon} alt="" width="28" height="28" loading="lazy" />
            <div>
              <h3><a href={item.link}>{item.name}</a> {item.alpha && <span class="alpha">alpha</span>}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </details>
  </section>

  <section class="container home-section" aria-labelledby="concerns-title">
    <SectionHead id="concerns-title" title={content.concerns.title} />
    <ul class="concerns">
      {content.concerns.items.map((item) => (
        <li>
          <img src={item.icon} alt="" width="32" height="32" loading="lazy" />
          <h3><a href={item.link}>{item.name}</a></h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container home-section" aria-labelledby="case-studies-title">
    <SectionHead id="case-studies-title" title="来自真实场景的实践" href="/testimonials/" linkLabel="全部案例" />
    <ul class="case-studies">
      {caseStudies.map((item) => (
        <li>
          <a href={item.link}>
            <img src={item.image} alt="" width="640" height="360" loading="lazy" />
            <h3>{item.name}</h3>
            <p>{item.title}</p>
            <span class="case-link">阅读案例 <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
    <h3 class="adopters-title">官网列出的采用者</h3>
    <ul class="adopter-logos">
      {content.adopters.map((adopter) => (
        <li><img src={adopter.image} alt={adopter.name} width="140" height="64" loading="lazy" /></li>
      ))}
    </ul>
  </section>

  <section class="container home-section" aria-labelledby="ecosystem-title">
    <SectionHead id="ecosystem-title" title="生态工具与学习资源" href="/enterprise/" linkLabel="企业解决方案" />
    <ul class="ecosystem">
      {content.banner.map((item) => (
        <li><a href={item.link}>{item.prefix}</a><p>{item.text}</p></li>
      ))}
    </ul>
    <div class="cncf">
      <img src="/media/official/cncf-color.svg" alt="Cloud Native Computing Foundation" width="240" height="70" loading="lazy" />
      <p>Dapr 是 <a href="https://www.cncf.io/projects">CNCF 毕业项目</a>。</p>
    </div>
  </section>
</div>

<style>
  .section-intro {
    max-width: 70ch;
    margin: 0 0 1.75rem;
    color: var(--color-muted);
  }
  .source-note {
    max-width: 70ch;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .concerns,
  .case-studies,
  .api-list,
  .adopter-logos,
  .ecosystem {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  li {
    margin: 0;
    min-width: 0;
  }
  h3 {
    margin: 0.65rem 0 0.5rem;
  }
  p {
    margin: 0.5rem 0 0;
  }

  /* Card and list titles are links, but they read as titles: no underline until hover. */
  .concerns h3 a,
  .api-list h3 a {
    color: var(--color-text);
    text-decoration: none;
  }
  .concerns h3 a:hover,
  .api-list h3 a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }

  .concerns {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .concerns li {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .concerns img,
  .api-list > li > img {
    padding: 4px;
    border-radius: 6px;
    background: var(--official-artwork-bg);
  }
  .concerns p,
  .api-list p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .value-rows {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .value-item h3 {
    font-size: 1.25rem;
    margin-top: 1rem;
  }
  .value-item p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  figure img {
    width: 100%;
    height: auto;
    background: var(--official-artwork-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }
  .api-diagram {
    margin-block: 0 1.5rem;
  }

  .api-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-link);
  }
  .api-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0 2rem;
  }
  .api-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .api-list > li > img {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .api-list h3 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .alpha {
    padding: 0.15em 0.5em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .case-studies {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .case-studies a {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }
  .case-studies a:hover {
    border-color: var(--color-link);
  }
  .case-studies img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    padding: 1.25rem;
    background: var(--official-artwork-bg);
  }
  .case-studies h3,
  .case-studies p,
  .case-link {
    margin-inline: 1.25rem;
  }
  .case-studies p {
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
  .case-link {
    margin-top: auto;
    margin-bottom: 1.25rem;
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .adopters-title {
    margin: 2.5rem 0 0;
    font-size: 1rem;
    color: var(--color-muted);
  }
  /* Tiles wrap and centre, so a short last row reads as intended instead of leaving a hole. */
  .adopter-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .adopter-logos li {
    flex: 1 1 130px;
    max-width: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--official-artwork-bg);
  }
  .adopter-logos img {
    width: 120px;
    height: 56px;
    object-fit: contain;
  }

  .ecosystem {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    border-block: 1px solid var(--color-border);
    padding-block: 1.5rem;
  }
  .ecosystem a {
    font-weight: 700;
  }
  .ecosystem p {
    font-size: 0.95rem;
    color: var(--color-muted);
  }
  /* One line: the mark and the sentence side by side, not a padded panel. */
  .cncf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  .cncf img {
    width: auto;
    height: 40px;
    background: var(--official-artwork-bg);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
  }
  .cncf p {
    margin: 0;
  }

  @media (max-width: 640px) {
    /* Icon beside the title instead of on a line of its own. */
    .concerns li {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 0.75rem;
      align-items: center;
    }
    .concerns h3 {
      margin: 0;
    }
    .concerns p {
      grid-column: 1 / -1;
    }

    /* Three case studies as a swipeable row rather than three screens of cards. */
    .case-studies {
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    .case-studies li {
      scroll-snap-align: start;
    }
    .case-studies img {
      padding: 0.75rem;
    }

    .adopter-logos {
      gap: 0.5rem;
    }
    .adopter-logos li {
      flex-basis: 76px;
      padding: 0.5rem;
    }
    .adopter-logos img {
      width: 100%;
      height: 36px;
    }
  }
</style>
