<button type="button" class="search-toggle" data-search-open aria-haspopup="dialog" aria-controls="site-search" aria-label="搜索">
  <span aria-hidden="true">⌕</span>
  <span class="search-label">搜索</span>
</button>

<dialog id="site-search" class="search-dialog" aria-label="搜索站点内容">
  <div class="search-head">
    <strong>搜索文章、活动和出版物</strong>
    <button type="button" class="search-close" data-search-close aria-label="关闭搜索">关闭</button>
  </div>
  <div id="search-ui" class="search-ui">
    <p class="search-status" data-search-status>正在加载搜索…</p>
  </div>
</dialog>

<script>
  // Pagefind writes its index and UI into dist/pagefind at build time. In development there is no
  // index, so the dialog says so instead of failing silently.
  const dialog = document.getElementById('site-search') as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  let loading: Promise<void> | undefined;

  function loadPagefind(): Promise<void> {
    if (loading) return loading;
    loading = new Promise<void>((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('pagefind unavailable'));
      document.head.appendChild(script);
    });
    return loading;
  }

  async function mountSearch() {
    const container = document.getElementById('search-ui');
    if (!container || container.dataset.mounted === 'true') return;
    try {
      await loadPagefind();
      const PagefindUI = (window as unknown as { PagefindUI: new (options: object) => unknown }).PagefindUI;
      container.innerHTML = '';
      new PagefindUI({
        element: '#search-ui',
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: '输入关键词，例如：服务调用',
          zero_results: '没有找到与「[SEARCH_TERM]」相关的内容',
        },
      });
      container.dataset.mounted = 'true';
      const input = container.querySelector<HTMLInputElement>('input');
      input?.focus();
    } catch {
      if (status) status.textContent = '搜索索引不可用。构建后（pnpm run build）才会生成搜索索引。';
    }
  }

  openButton?.addEventListener('click', () => {
    dialog?.showModal();
    mountSearch();
  });
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    // A click on the backdrop (the dialog element itself) closes it.
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .search-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: var(--color-header-text);
    font-size: 0.95rem;
    cursor: pointer;
  }

  .search-toggle:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .search-dialog {
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100vh - 48px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    padding: 16px;
  }

  .search-dialog::backdrop {
    background: rgba(5, 8, 20, 0.55);
  }

  .search-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .search-close {
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    border-radius: 6px;
    padding: 4px 10px;
    cursor: pointer;
  }

  .search-ui {
    overflow-y: auto;
    max-height: calc(100vh - 120px);
  }

  .search-status {
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .search-label {
      display: none;
    }
  }
</style>
