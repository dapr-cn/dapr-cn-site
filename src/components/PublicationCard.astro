---
import type { CollectionEntry } from 'astro:content';
import CardCue from './CardCue.astro';
import { formatDate } from '../lib/format';
import { urls } from '../lib/urls';

interface Props {
  publication: CollectionEntry<'publication'>;
  /** Heading level of the card title: 3 under a section heading, 2 on a list page whose only heading is the h1. */
  level?: 2 | 3;
}

const { publication, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<li class="card publication-card" data-card>
  <Heading><a href={urls.publication(publication.id)}>{publication.data.title}</a></Heading>
  <ul class="meta">
    <li><time datetime={publication.data.date.toISOString()}>{formatDate(publication.data.date)}</time></li>
    {publication.data.publication && <li>{publication.data.publication}</li>}
  </ul>
  {publication.data.abstract && <p class="summary">{publication.data.abstract}</p>}
  <div class="card-foot">
    <CardCue label="查看出版物" />
  </div>
</li>
