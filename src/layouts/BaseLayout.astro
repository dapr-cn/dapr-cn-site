---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/cards.css';
import type { MarkdownHeading } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { site } from '../config/site';

interface Props {
  /** Page name, shown before the site name in the title. Omit for the home page. */
  title?: string;
  /** Meta description. Articles pass their summary. */
  description?: string;
  /** Path of this page with a trailing slash. The canonical link comes from Starlight's route. */
  path: string;
  /** Kept for callers; the Open Graph type is set by Starlight's head. */
  type?: 'website' | 'article';
  /** Headings of the page body. When given, Starlight shows them as the "on this page" contents. */
  headings?: MarkdownHeading[];
}

const { title, description = site.description, headings } = Astro.props;
---

<!-- The page frame (html, head, masthead, footer, search and theme wiring) comes from Starlight.
     The site's overrides live in src/components/starlight/ and src/components/Header.astro. -->
<!-- pagefind: false keeps Pagefind to the article bodies that ArticleLayout marks itself. -->
<!-- Starlight shows the "on this page" contents only on the doc template, so pages with headings use it. -->
<StarlightPage
  frontmatter={{ title: title ?? site.title, description, template: headings ? 'doc' : 'splash', pagefind: false }}
  hasSidebar={false}
  headings={headings}
>
  <slot />
</StarlightPage>
